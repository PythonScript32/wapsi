# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — NEVER commit
.env
dashboard/.env
*.pem

# Node
node_modules/
dashboard/dist/

# Data (generated + snapshots) — keep the four checked-in reference/result
# files the deployed dashboard needs; ignore everything else generated here
# (wapsi.db, ad-hoc results_*.json from other batch runs, etc.)
data/*
!data/.gitkeep
!data/cases_dev.json
!data/cases_holdout.json
!data/results_dev.json
!data/results_holdout.json

# Dashboard's copy of the results JSON, regenerated by scripts/copy-data.js
# before every dev/build run (see dashboard/package.json) -- never edit
# these directly, they're overwritten from data/ above every time.
dashboard/public/data/

# OS / editor
.DS_Store
.vscode/
.idea/
