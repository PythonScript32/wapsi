# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# Razorpay — TEST MODE ONLY (Dashboard → toggle Test → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxxxxxxxxx   # service_role — BACKEND ONLY, never in frontend

# Gemini — the agent's runtime brain (aistudio.google.com, free tier)
GEMINI_API_KEY=xxxxxxxxxxxx

# ElevenLabs — outbound Hinglish voice (optional stretch)
ELEVENLABS_API_KEY=xxxxxxxxxxxx
ELEVENLABS_VOICE_ID=xxxxxxxxxxxx
